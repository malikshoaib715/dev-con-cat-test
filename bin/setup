#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "socket"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

def abort_with_instructions(service, instructions)
  abort <<~MESSAGE

    == #{service} is not reachable ==

    This application needs #{service} running before it can be set up.

    #{instructions}

  MESSAGE
end

def reachable?(host, port)
  Socket.tcp(host, port, connect_timeout: 2, &:close)
  true
rescue StandardError
  false
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Checking services =="

  unless system("pg_isready -q")
    abort_with_instructions "PostgreSQL", <<~HINT.strip
      macOS (Homebrew):  brew install postgresql@17 && brew services start postgresql@17
      Docker:            docker run -d -p 5432:5432 -e POSTGRES_HOST_AUTH_METHOD=trust postgres:17
    HINT
  end
  puts "PostgreSQL ....... ok"

  redis_url = ENV.fetch("REDIS_URL", "redis://localhost:6379/1")
  redis_host = redis_url[%r{//([^:/]+)}, 1] || "localhost"
  redis_port = (redis_url[%r{//[^:/]+:(\d+)}, 1] || 6379).to_i

  unless reachable?(redis_host, redis_port)
    abort_with_instructions "Redis (#{redis_host}:#{redis_port})", <<~HINT.strip
      Redis backs both Sidekiq and Action Cable.

      macOS (Homebrew):  brew install redis && brew services start redis
      Docker:            docker run -d -p 6379:6379 redis:7
    HINT
  end
  puts "Redis ............ ok"

  puts "\n== Preparing database =="
  if ARGV.include?("--reset")
    system! "bin/rails db:drop db:create db:migrate db:seed"
  else
    system! "bin/rails db:prepare"
  end

  # The stylesheet is a build artifact and is not committed. bin/dev's watcher
  # would build it anyway; doing it here means a server started any other way
  # (or a test run) is styled too.
  puts "\n== Building assets =="
  system! "bin/rails tailwindcss:build"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush
    exec "bin/dev"
  end
end
