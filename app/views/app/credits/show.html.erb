<% content_for :title, "Credits" %>

<h1 class="text-xl font-semibold">Credits</h1>

<div class="mt-4 grid gap-6 md:grid-cols-3">
  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Balance</h2>
    <p class="mt-2 text-3xl font-semibold"><%= number_with_delimiter(current_account.credit_balance) %></p>
    <p class="mt-1 text-sm text-slate-500">
      <%= current_account.allowance_used_percent %>% of this cycle's
      <%= number_with_delimiter(current_account.monthly_credit_allowance) %> used.
    </p>
  </section>

  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Burn rate</h2>
    <p class="mt-2 text-3xl font-semibold"><%= @runway.daily_burn %></p>
    <p class="mt-1 text-sm text-slate-500">credits a day, over the last seven.</p>
  </section>

  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Runway</h2>
    <p class="mt-2 text-3xl font-semibold"><%= runway_text(@runway.days_to_zero) %></p>
    <p class="mt-1 text-sm text-slate-500">
      Cycle <%= current_account.cycle_start.strftime("%d %b") %> –
      <%= current_account.cycle_end.strftime("%d %b %Y") %>.
    </p>
  </section>
</div>

<div class="mt-6 flex items-baseline justify-between">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Ledger</h2>
  <p class="text-sm text-slate-500"><%= pluralize(@pagy.count, "movement") %></p>
</div>
<p class="mt-1 text-sm text-slate-500">
  Append-only, and the authority: the balance above is a cached projection of these rows.
</p>

<div class="mt-4 overflow-hidden rounded-lg border border-slate-200 bg-white">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3 font-medium">When</th>
        <th class="px-4 py-3 font-medium">Movement</th>
        <th class="px-4 py-3 font-medium">Amount</th>
        <th class="px-4 py-3 font-medium">Balance after</th>
        <th class="px-4 py-3 font-medium">Lead</th>
        <th class="px-4 py-3 font-medium">Detail</th>
      </tr>
    </thead>

    <tbody class="divide-y divide-slate-100">
      <% @entries.each do |entry| %>
        <% lead = entry.verification_run&.lead %>
        <tr>
          <td class="px-4 py-3 text-slate-500"><%= entry.created_at.strftime("%d %b %H:%M") %></td>
          <td class="px-4 py-3">
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
              <%= entry.entry_type.humanize %>
            </span>
          </td>
          <td class="px-4 py-3 font-medium <%= entry.amount.negative? ? "text-rose-700" : "text-emerald-700" %>">
            <%= entry.amount.positive? ? "+#{entry.amount}" : entry.amount %>
          </td>
          <td class="px-4 py-3 text-slate-600"><%= number_with_delimiter(entry.balance_after) %></td>
          <td class="px-4 py-3">
            <% if lead %>
              <%= link_to lead.public_id, app_lead_path(lead), class: "font-mono text-xs hover:underline" %>
            <% else %>
              <span class="text-slate-400">—</span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-slate-600">
            <div><%= entry.memo.presence || "—" %></div>
            <% if entry.breakdown.present? %>
              <%# What each layer cost, or what each unrun layer gave back. %>
              <details class="mt-1">
                <summary class="cursor-pointer text-xs text-slate-500 hover:text-slate-900">
                  <%= pluralize(entry.breakdown.size, "layer") %>
                </summary>
                <ul class="mt-1 space-y-0.5 text-xs text-slate-500">
                  <% entry.breakdown.each do |layer_key, cost| %>
                    <li><%= Layers::Registry.label(layer_key) %> · <%= cost %></li>
                  <% end %>
                </ul>
              </details>
            <% end %>
          </td>
        </tr>
      <% end %>

      <% if @entries.empty? %>
        <tr>
          <td colspan="6" class="px-4 py-10 text-center text-slate-500">
            No movements yet.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @pagy.pages > 1 %>
  <div class="mt-4 text-sm"><%== pagy_nav(@pagy) %></div>
<% end %>
