<% content_for :title, "Pixels" %>

<div class="flex items-baseline justify-between">
  <h1 class="text-xl font-semibold">Pixels</h1>
  <% if policy(Pixel).create? %>
    <%= link_to "New pixel", new_app_pixel_path,
                class: "rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
  <% end %>
</div>

<div class="mt-4 overflow-hidden rounded-lg border border-slate-200 bg-white">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3 font-medium">Pixel</th>
        <th class="px-4 py-3 font-medium">Allowed domains</th>
        <th class="px-4 py-3 font-medium">Layers</th>
        <th class="px-4 py-3 font-medium">Cost / run</th>
        <th class="px-4 py-3 font-medium">Status</th>
      </tr>
    </thead>

    <tbody class="divide-y divide-slate-100">
      <% @pixels.each do |pixel| %>
        <tr>
          <td class="px-4 py-3">
            <%= link_to pixel.name, app_pixel_path(pixel), class: "font-medium text-slate-900 hover:underline" %>
            <div class="font-mono text-xs text-slate-500"><%= pixel.public_id %></div>
          </td>
          <td class="px-4 py-3 text-slate-600"><%= pixel.allowed_domains.join(", ").presence || "—" %></td>
          <td class="px-4 py-3 text-slate-600"><%= pixel.effective_layer_keys.size %></td>
          <td class="px-4 py-3 text-slate-600"><%= pluralize(cost_per_run(pixel, @layer_costs), "credit") %></td>
          <td class="px-4 py-3">
            <%= render "app/pixels/status", pixel: pixel %>
          </td>
        </tr>
      <% end %>

      <% if @pixels.empty? %>
        <tr>
          <td colspan="5" class="px-4 py-10 text-center text-slate-500">
            No pixels yet. Create one to get a snippet you can paste onto a landing page.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
