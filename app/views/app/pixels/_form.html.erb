<%= form_with model: pixel, url: url, class: "mt-6 space-y-6" do |form| %>
  <% if pixel.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <p class="font-medium"><%= pluralize(pixel.errors.count, "problem") %> stopped this from saving:</p>
      <ul class="mt-2 list-inside list-disc">
        <% pixel.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-lg border border-slate-200 bg-white p-5">
    <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>

    <label class="mt-4 flex items-center gap-2 text-sm text-slate-700">
      <%= form.check_box :active, class: "rounded border-slate-300" %>
      Active — a paused pixel refuses submissions
    </label>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white p-5">
    <%= form.label :allowed_domains, "Allowed domains", class: "block text-sm font-medium text-slate-700" %>
    <p class="mt-1 text-sm text-slate-500">
      One hostname per line. A submission from anywhere else is refused, which is what
      makes a copied snippet useless to somebody else.
    </p>
    <%= form.text_area :allowed_domains, rows: 4, value: pixel.allowed_domains.join("\n"),
                       class: "mt-2 w-full rounded-md border border-slate-300 px-3 py-2 font-mono text-xs" %>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-700">Detection layers</h2>
    <p class="mt-1 text-sm text-slate-500">
      Only the layers this account's plan includes can be switched on. Each one bills
      its own cost per verification.
    </p>

    <%= hidden_field_tag "pixel[enabled_layers][]", "" %>
    <div class="mt-3 grid gap-2 sm:grid-cols-2">
      <% @layer_definitions.each do |definition| %>
        <% next unless purchased_layer_keys.include?(definition.key) %>
        <label class="flex items-center gap-2 rounded-md border border-slate-200 px-3 py-2 text-sm">
          <%= check_box_tag "pixel[enabled_layers][]", definition.key,
                            pixel.enabled_layers.include?(definition.key),
                            id: "pixel_enabled_layers_#{definition.key}", class: "rounded border-slate-300" %>
          <span class="flex-1"><%= definition.name %></span>
          <span class="text-xs text-slate-500"><%= definition.cost_credits %> cr</span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit submit_label,
                    class: "rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
    <%= link_to "Cancel", app_pixels_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
  </div>
<% end %>
