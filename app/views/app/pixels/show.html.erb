<% content_for :title, @pixel.name %>

<div class="flex items-baseline justify-between">
  <div>
    <h1 class="text-xl font-semibold"><%= @pixel.name %></h1>
    <p class="font-mono text-xs text-slate-500"><%= @pixel.public_id %></p>
  </div>

  <div class="flex items-center gap-3">
    <%= render "app/pixels/status", pixel: @pixel %>
    <% if policy(@pixel).update? %>
      <%= link_to "Edit", edit_app_pixel_path(@pixel),
                  class: "rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
    <% end %>
  </div>
</div>

<section class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
  <h2 class="text-sm font-semibold">Snippet</h2>
  <p class="mt-1 text-sm text-slate-500">
    Paste this into the <code>&lt;head&gt;</code> of every page carrying the lead form.
  </p>

  <div class="mt-3" data-controller="clipboard">
    <pre class="overflow-x-auto rounded-md bg-slate-900 p-4 text-xs text-slate-100"
         data-clipboard-target="source"><%= @snippet %></pre>

    <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
            class="mt-2 rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-100">
      Copy snippet
    </button>
  </div>
</section>

<div class="mt-6 grid gap-6 md:grid-cols-2">
  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-semibold">Detection layers</h2>
    <p class="mt-1 text-sm text-slate-500">
      <%= pluralize(cost_per_run(@pixel, @layer_costs), "credit") %> per verification.
      Greyed layers are not in this account's plan and never run.
    </p>

    <ul class="mt-3 flex flex-wrap gap-2">
      <% @layer_definitions.each do |definition| %>
        <% if @pixel.effective_layer_keys.include?(definition.key) %>
          <li class="rounded-full bg-slate-900 px-3 py-1 text-xs font-medium text-white">
            <%= definition.name %> · <%= definition.cost_credits %>
          </li>
        <% elsif purchased_layer_keys.include?(definition.key) %>
          <li class="rounded-full border border-slate-300 px-3 py-1 text-xs text-slate-600">
            <%= definition.name %> · off
          </li>
        <% else %>
          <li class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-400">
            <%= definition.name %> · not in plan
          </li>
        <% end %>
      <% end %>
    </ul>
  </section>

  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-semibold">Allowed domains</h2>
    <p class="mt-1 text-sm text-slate-500">
      A submission from anywhere else is refused, so a stolen snippet is worthless.
    </p>

    <ul class="mt-3 space-y-1 text-sm text-slate-700">
      <% @pixel.allowed_domains.each do |domain| %>
        <li class="font-mono text-xs"><%= domain %></li>
      <% end %>
      <% if @pixel.allowed_domains.empty? %>
        <li class="text-slate-500">None — this pixel will refuse every submission.</li>
      <% end %>
    </ul>
  </section>
</div>

<% if policy(@pixel).destroy? %>
  <div class="mt-6">
    <%= button_to "Delete pixel", app_pixel_path(@pixel), method: :delete,
                  form: { data: { turbo_confirm: "Delete #{@pixel.name}?" } },
                  class: "rounded-md border border-red-300 px-3 py-2 text-sm text-red-700 hover:bg-red-50" %>
  </div>
<% end %>
