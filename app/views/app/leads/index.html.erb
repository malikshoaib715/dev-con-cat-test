<% content_for :title, "Leads" %>
<%# One stream per account, named by its public id. turbo-rails signs the name
    into the page, so a visitor cannot subscribe to another account's feed by
    editing it. %>
<%= turbo_stream_from "account_#{current_account.public_id}_leads" %>

<div class="flex items-baseline justify-between">
  <h1 class="text-xl font-semibold">Leads</h1>
  <p class="text-sm text-slate-500"><%= pluralize(@pagy.count, "lead") %></p>
</div>

<div class="mt-4">
  <%= render "shared/filter_bar", url: app_leads_path, fields: lead_filter_fields %>
</div>

<div class="mt-4 overflow-hidden rounded-lg border border-slate-200 bg-white">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3 font-medium">Lead</th>
        <th class="px-4 py-3 font-medium">Contact</th>
        <th class="px-4 py-3 font-medium">Pixel</th>
        <th class="px-4 py-3 font-medium">Status</th>
        <th class="px-4 py-3 font-medium">Verdict</th>
        <th class="px-4 py-3 font-medium">Score</th>
        <th class="px-4 py-3 font-medium">Submitted</th>
      </tr>
    </thead>

    <tbody id="leads" class="divide-y divide-slate-100">
      <%= render partial: "app/leads/lead", collection: @leads %>

      <% if @leads.empty? %>
        <tr>
          <td colspan="7" class="px-4 py-10 text-center text-slate-500">
            No leads match. Clear the filters, or embed a pixel and submit a form to see them here.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @pagy.pages > 1 %>
  <div class="mt-4 text-sm"><%== pagy_nav(@pagy) %></div>
<% end %>
