<% content_for :title, @lead.full_name || @lead.public_id %>
<% verdict = @lead.consensus_verdict %>

<div class="flex items-baseline justify-between">
  <div>
    <h1 class="text-xl font-semibold"><%= @lead.full_name || "Unnamed lead" %></h1>
    <p class="font-mono text-xs text-slate-500"><%= @lead.public_id %></p>
  </div>

  <div class="flex items-center gap-3">
    <%= status_badge(@lead.status) %>
    <%= verdict_badge(@lead.verdict) %>
    <% if policy(@lead).reverify? && @lead.reverifiable? %>
      <%= button_to "Re-verify", reverify_app_lead_path(@lead),
                    class: "rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
    <% end %>
  </div>
</div>

<section class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Who filled the form in</h2>

  <dl class="mt-4 grid grid-cols-2 gap-4 text-sm sm:grid-cols-3">
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Email</dt>
      <dd class="break-all"><%= @lead.email.presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Phone</dt>
      <dd><%= @lead.phone.presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Submitted</dt>
      <dd><%= @lead.submitted_at.strftime("%d %b %Y %H:%M UTC") %></dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Pixel</dt>
      <dd><%= link_to @lead.pixel.public_id, app_pixel_path(@lead.pixel), class: "font-mono text-xs hover:underline" %></dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Captured from</dt>
      <dd class="truncate"><%= @lead.page_url.presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Time on form</dt>
      <dd><%= @lead.form_dwell_ms ? "#{@lead.form_dwell_ms} ms" : "—" %></dd>
    </div>
    <div>
      <%# The §6 bargain made visible: field churn stays on the page, and only
          this summary was ever persisted — one bounded write on the visit. %>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Form activity</dt>
      <dd><%= @visit&.interactions.present? ? pluralize(@visit.interactions.size, "field event") : "—" %></dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Session</dt>
      <dd class="font-mono text-xs"><%= @lead.session_id %></dd>
    </div>
    <div>
      <%# The two addresses the VPN layer compares: browsed from one place,
          submitted from another is a signal in itself. %>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Visit / submit IP</dt>
      <dd><%= @visit&.ip_address || "—" %> / <%= @lead.ip_address.presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Flags</dt>
      <dd><%= @lead.flags.any? ? flag_chips(@lead.flags) : "—" %></dd>
    </div>
  </dl>
</section>

<section class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white">
  <div class="border-b border-slate-200 px-5 py-4">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Detection layers</h2>
    <p class="mt-1 text-sm text-slate-500">
      All ten, including the ones this account does not run — a check that never ran is
      never presented as a check that passed.
    </p>
  </div>

  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3 font-medium">Check</th>
        <th class="px-4 py-3 font-medium">State</th>
        <th class="px-4 py-3 font-medium">Answer</th>
        <th class="px-4 py-3 font-medium">What it means</th>
        <th class="px-4 py-3 font-medium">Score</th>
        <th class="px-4 py-3 font-medium">Took</th>
      </tr>
    </thead>

    <tbody class="divide-y divide-slate-100">
      <% @layer_results.each do |layer_result| %>
        <tr>
          <td class="px-4 py-3 font-medium"><%= layer_result.label %></td>
          <td class="px-4 py-3"><%= layer_state_badge(layer_result) %></td>
          <td class="px-4 py-3 text-slate-600"><%= layer_result.verdict.presence || "—" %></td>
          <td class="px-4 py-3 text-slate-600"><%= layer_result.detail.presence || "—" %></td>
          <td class="px-4 py-3 <%= "font-medium text-rose-700" if layer_result.score_delta.to_i.negative? %>">
            <%= layer_score_delta(layer_result) %>
          </td>
          <td class="px-4 py-3 text-slate-500"><%= layer_duration(layer_result) %></td>
        </tr>
      <% end %>

      <% if @layer_results.empty? %>
        <tr>
          <td colspan="6" class="px-4 py-10 text-center text-slate-500">
            No verification has been funded for this lead yet.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">The decision</h2>

    <% if verdict %>
      <div class="mt-3 flex items-baseline gap-3">
        <%= verdict_badge(verdict.verdict) %>
        <span class="text-2xl font-semibold"><%= verdict.score %></span>
        <span class="text-sm text-slate-500">/ 100</span>
      </div>

      <% if verdict.hard_stop_layer.present? %>
        <p class="mt-3 rounded-md bg-rose-50 px-3 py-2 text-sm text-rose-800">
          Hard stop: <%= Layers::Registry.label(verdict.hard_stop_layer) %>. No score outweighs this.
        </p>
      <% end %>

      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate-700">
        <% verdict.reasons.each do |reason| %>
          <li><%= reason %></li>
        <% end %>
      </ul>

      <%# The exact rules this verdict was reached under, kept with the verdict so
          it stays explainable after the buyer retunes their policy. %>
      <details class="mt-4">
        <summary class="cursor-pointer text-sm text-slate-500 hover:text-slate-900">Policy snapshot</summary>
        <pre class="mt-2 overflow-x-auto rounded-md bg-slate-900 p-3 text-xs text-slate-100"><%= audit_payload_json(verdict.policy_snapshot) %></pre>
      </details>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">
        <%= @lead.on_hold_insufficient_credits? ? "Held: this verification has not been funded." : "Still verifying." %>
      </p>
    <% end %>
  </section>

  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Consent certificate</h2>

    <% if @certificate %>
      <p class="mt-3 font-mono text-xs"><%= @certificate.public_id %></p>
      <p class="mt-1 text-sm text-slate-500">
        Issued <%= @certificate.issued_at.strftime("%d %b %Y %H:%M UTC") %>, position
        #<%= @certificate.sequence_number %> in this account's chain.
      </p>
      <p class="mt-3 text-sm">
        <%= link_to "Public verification page", verify_certificate_path(@certificate.public_id),
                    class: "text-slate-900 underline" %>
      </p>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">No certificate has been issued for this lead yet.</p>
    <% end %>
  </section>
</div>

<section class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
  <div class="flex items-baseline justify-between">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Activity</h2>
    <span class="text-xs text-slate-500">
      <%= pluralize(@timeline.size, "event") %> ·
      <%= link_to "view in audit explorer", app_audit_events_path(session_id: @lead.session_id),
                  class: "underline" %>
    </span>
  </div>
  <p class="mt-1 text-sm text-slate-500">
    Everything recorded against this lead and the browsing session it came from —
    the same rows the live panel rendered.
  </p>

  <ol class="mt-4 space-y-3">
    <% @timeline.each do |event| %>
      <li class="border-l-2 border-slate-200 pl-4">
        <div class="flex flex-wrap items-baseline gap-2">
          <%= audit_event_chip(event.event_type) %>
          <span class="text-xs text-slate-500">
            <%= event.occurred_at.strftime("%d %b %H:%M:%S") %> · <%= audit_actor(event) %>
          </span>
        </div>
        <p class="mt-1 text-sm text-slate-700"><%= audit_payload_summary(event.payload) %></p>
      </li>
    <% end %>
  </ol>
</section>
