<% content_for :title, "Certificate #{@certificate.public_id}" %>
<% evidence = @certificate.evidence %>

<div class="mx-auto max-w-4xl">
  <% if @report.valid? %>
    <div class="rounded-lg border border-emerald-300 bg-emerald-50 px-5 py-4">
      <p class="text-lg font-semibold text-emerald-900">VALID</p>
      <p class="mt-1 text-sm text-emerald-800">Hash valid, chain intact.</p>
    </div>
  <% else %>
    <div class="rounded-lg border border-rose-300 bg-rose-50 px-5 py-4">
      <p class="text-lg font-semibold text-rose-900">TAMPERED</p>
      <p class="mt-1 text-sm text-rose-800">
        <%= @report.hash_valid ? "Hash valid, but this certificate no longer follows the one before it." : "The evidence stored here does not match the digest recorded when it was issued." %>
      </p>
    </div>
  <% end %>

  <div class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
    <div class="flex items-baseline justify-between">
      <div>
        <h1 class="text-xl font-semibold">Consent certificate</h1>
        <p class="font-mono text-xs text-slate-500"><%= @certificate.public_id %></p>
      </div>
      <%= verdict_badge(@certificate.verdict) %>
    </div>

    <dl class="mt-5 grid grid-cols-2 gap-4 text-sm sm:grid-cols-3">
      <div>
        <dt class="text-xs uppercase tracking-wide text-slate-500">Lead</dt>
        <dd>
          <%= link_to @certificate.lead.public_id, app_lead_path(@certificate.lead),
                      class: "font-mono text-xs hover:underline" %>
        </dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-slate-500">Score</dt>
        <dd><%= evidence.dig("consensus", "score") %> / 100</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-slate-500">Issued</dt>
        <dd><%= @certificate.issued_at.strftime("%d %b %Y %H:%M UTC") %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-slate-500">Captured from</dt>
        <dd class="truncate"><%= evidence.dig("pixel", "page_url") %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-slate-500">Visit / submit IP</dt>
        <dd><%= evidence.dig("session", "visit_ip") || "—" %> / <%= evidence.dig("session", "submit_ip") || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-slate-500">Chain position</dt>
        <dd>#<%= @certificate.sequence_number %></dd>
      </div>
    </dl>

    <% if @certificate.trustedform_reference.present? %>
      <p class="mt-4 break-all text-xs text-slate-500">
        TrustedForm: <%= @certificate.trustedform_reference %>
        (<%= evidence.dig("trustedform", "status") || "not checked" %>)
      </p>
    <% end %>

    <p class="mt-4 text-sm">
      <%= link_to "Public verification page", verify_certificate_path(@certificate.public_id),
                  class: "text-slate-900 underline" %>
      <span class="text-slate-500">— the same evidence, checkable by anyone holding the link.</span>
    </p>
  </div>

  <div class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Why</h2>
    <ul class="mt-3 space-y-1 text-sm text-slate-700">
      <% Array(evidence.dig("consensus", "reasons")).each do |reason| %>
        <li><%= reason %></li>
      <% end %>
    </ul>
  </div>

  <div class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white">
    <%= render "shared/evidence_layers", evidence: evidence %>
  </div>

  <div class="mt-6 rounded-lg border border-slate-200 bg-white p-5 text-xs">
    <%= render "shared/certificate_integrity", certificate: @certificate, report: @report %>
  </div>
</div>
