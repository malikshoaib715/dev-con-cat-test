<% content_for :title, "Audit" %>

<div class="flex items-baseline justify-between">
  <div>
    <h1 class="text-xl font-semibold">Audit</h1>
    <p class="mt-1 text-sm text-slate-500">
      Every write this account made or had made for it, in the order it happened.
      Append-only: nothing here can be edited or removed.
    </p>
  </div>
  <p class="text-sm text-slate-500"><%= pluralize(@pagy.count, "event") %></p>
</div>

<div class="mt-4">
  <%= render "shared/filter_bar", url: app_audit_events_path, fields: audit_filter_fields,
                                  hidden: subject_filter_params %>
</div>

<% if filters[:subject] %>
  <p class="mt-3 text-sm text-slate-600">
    Showing one record only:
    <span class="font-mono text-xs"><%= filters[:subject].join(" #") %></span>
    <%= link_to "clear", app_audit_events_path(request.query_parameters.except("subject_type", "subject_id")),
                class: "ml-1 text-slate-500 underline" %>
  </p>
<% end %>

<div class="mt-4">
  <%= render "shared/audit_events_table", events: @events %>
</div>

<% if @pagy.pages > 1 %>
  <div class="mt-4 text-sm"><%== pagy_nav(@pagy) %></div>
<% end %>
