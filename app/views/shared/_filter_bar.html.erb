<%# locals: (url:, fields:, hidden: {}) %>
<%# A GET form: the filters end up in the URL, so a filtered view is a link a
    buyer can bookmark or send to a colleague. Shared by the CRM and both audit
    explorers, which filter different columns but read identically. %>
<%= form_with url: url, method: :get, class: "flex flex-wrap items-end gap-3 rounded-lg border border-slate-200 bg-white p-4" do %>
  <% hidden.each do |name, value| %>
    <%= hidden_field_tag name, value, id: nil %>
  <% end %>

  <% fields.each do |field| %>
    <div class="flex flex-col gap-1">
      <label class="text-xs font-medium uppercase tracking-wide text-slate-500" for="filter_<%= field[:name] %>">
        <%= field[:label] %>
      </label>

      <% case field[:type] %>
      <% when :select %>
        <%= select_tag field[:name],
                       options_for_select(field[:options], params[field[:name]]),
                       include_blank: field.fetch(:prompt, "Any"),
                       id: "filter_#{field[:name]}",
                       class: "w-44 rounded-md border-slate-300 text-sm" %>
      <% when :grouped_select %>
        <%= select_tag field[:name],
                       grouped_options_for_select(field[:groups], params[field[:name]]),
                       include_blank: field.fetch(:prompt, "Any"),
                       id: "filter_#{field[:name]}",
                       class: "w-44 rounded-md border-slate-300 text-sm" %>
      <% when :date %>
        <%= date_field_tag field[:name], params[field[:name]],
                           id: "filter_#{field[:name]}",
                           class: "rounded-md border-slate-300 text-sm" %>
      <% else %>
        <%= text_field_tag field[:name], params[field[:name]],
                           placeholder: field[:placeholder],
                           id: "filter_#{field[:name]}",
                           class: "w-64 rounded-md border-slate-300 text-sm" %>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center gap-2">
    <%= submit_tag "Filter", name: nil,
                   class: "rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
    <%= link_to "Clear", url, class: "px-2 py-2 text-sm text-slate-500 hover:text-slate-900" %>
  </div>
<% end %>
