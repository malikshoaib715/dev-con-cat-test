<%# locals: (events:, account_names: nil, link_subjects: true) %>
<%# One rendering of the spine, shared by the account explorer and the platform
    one. The platform view adds a column naming whose event it is; nothing else
    differs, because nothing else should. %>
<div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3 font-medium">When</th>
        <% if account_names %>
          <th class="px-4 py-3 font-medium">Account</th>
        <% end %>
        <th class="px-4 py-3 font-medium">Event</th>
        <th class="px-4 py-3 font-medium">Actor</th>
        <th class="px-4 py-3 font-medium">Subject</th>
        <th class="px-4 py-3 font-medium">Payload</th>
      </tr>
    </thead>

    <tbody class="divide-y divide-slate-100">
      <% events.each do |event| %>
        <tr>
          <td class="whitespace-nowrap px-4 py-3 text-slate-500">
            <%= event.occurred_at.strftime("%d %b %H:%M:%S") %>
          </td>
          <% if account_names %>
            <td class="px-4 py-3 text-slate-600"><%= account_names[event.account_id] || "platform" %></td>
          <% end %>
          <td class="px-4 py-3"><%= audit_event_chip(event.event_type) %></td>
          <td class="px-4 py-3 text-slate-600"><%= audit_actor(event) %></td>
          <td class="px-4 py-3 font-mono text-xs text-slate-600"><%= audit_subject_link(event, linked: link_subjects) %></td>
          <td class="px-4 py-3 text-slate-600">
            <div class="max-w-md truncate"><%= audit_payload_summary(event.payload) %></div>
            <% if event.payload.present? %>
              <details class="mt-1">
                <summary class="cursor-pointer text-xs text-slate-500 hover:text-slate-900">Full payload</summary>
                <pre class="mt-1 overflow-x-auto rounded-md bg-slate-900 p-2 text-xs text-slate-100"><%= audit_payload_json(event.payload) %></pre>
                <p class="mt-1 font-mono text-xs text-slate-400">request <%= event.request_id || "—" %></p>
              </details>
            <% end %>
          </td>
        </tr>
      <% end %>

      <% if events.empty? %>
        <tr>
          <td colspan="<%= account_names ? 6 : 5 %>" class="px-4 py-10 text-center text-slate-500">
            No events match these filters.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
