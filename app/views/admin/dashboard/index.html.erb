<% content_for :title, "Platform" %>

<h1 class="text-xl font-semibold">Platform</h1>

<section class="mt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Accounts</h2>
  <p class="mt-1 text-sm text-slate-500">
    Read-only: changing a buyer's plan, status or balance is a billing action, not a console one.
  </p>
  <div class="mt-3">
    <%= render "admin/accounts_table", summaries: @summaries %>
  </div>
</section>

<section class="mt-8">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Verdicts across the platform</h2>
  <div class="mt-3 grid gap-6 sm:grid-cols-3">
    <% ConsensusVerdict::VERDICTS.each do |verdict| %>
      <div class="rounded-lg border border-slate-200 bg-white p-5">
        <%= verdict_badge(verdict) %>
        <p class="mt-2 text-3xl font-semibold"><%= @verdict_counts.fetch(verdict, 0) %></p>
      </div>
    <% end %>
  </div>
</section>

<section class="mt-8">
  <div class="flex items-baseline justify-between">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Recent activity</h2>
    <%= link_to "Open the explorer", admin_audit_events_path, class: "text-sm text-slate-600 underline" %>
  </div>
  <div class="mt-3">
    <%= render "shared/audit_events_table", events: @recent_events,
                                            account_names: @account_names, link_subjects: false %>
  </div>
</section>
