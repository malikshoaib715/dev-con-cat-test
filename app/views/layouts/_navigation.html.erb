<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-3">
    <div class="flex items-center gap-6">
      <span class="text-sm font-semibold tracking-tight">Super&nbsp;Pixel</span>

      <% if user_signed_in? %>
        <nav class="flex items-center gap-4 text-sm">
          <% if current_user.account.present? %>
            <%= nav_link_to "Leads", app_leads_path %>
            <%= nav_link_to "Review queue", app_leads_path(verdict: "review"), badge_count: review_queue_count %>
            <%= nav_link_to "Pixels", app_pixels_path %>
            <%= nav_link_to "Certificates", app_certificates_path %>
            <%= nav_link_to "Credits", app_credits_path %>
          <% elsif current_user.super_admin? %>
            <%# A platform operator has no tenant of their own, so none of the
                account surfaces mean anything to them. %>
            <%= nav_link_to "Sidekiq", "/admin/sidekiq" %>
          <% end %>
        </nav>
      <% end %>
    </div>

    <% if user_signed_in? %>
      <div class="flex items-center gap-4 text-sm">
        <span class="text-slate-500">
          <%= current_user.name %>
          &middot;
          <%= current_user.role.humanize %>
          <%= "· #{current_user.account.name}" if current_user.account %>
        </span>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                      class: "rounded-md border border-slate-300 px-3 py-1 text-slate-700 hover:bg-slate-100" %>
      </div>
    <% end %>
  </div>
</header>
