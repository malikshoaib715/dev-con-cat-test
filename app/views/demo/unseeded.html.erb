<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Demo not seeded — Super Pixel</title>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <style>
      body {
        margin: 0; padding: 64px 20px;
        font: 15px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #0b1220; color: #e8eefc;
      }
      .card {
        max-width: 560px; margin: 0 auto; padding: 26px;
        background: #121b2e; border: 1px solid #22304a; border-radius: 14px;
      }
      h1 { font-size: 20px; margin: 0 0 10px; }
      p { color: #93a4c4; }
      code { background: #0e1728; padding: 2px 7px; border-radius: 5px; border: 1px solid #22304a; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>The demo pixel has not been seeded yet</h1>
      <p>
        This page runs on the seeded SolarPro pixel
        <code><%= DemoController::DEMO_PIXEL_PUBLIC_ID %></code>, which does not
        exist in this database.
      </p>
      <p>Run <code>bin/rails db:seed</code> and reload.</p>
    </div>
  </body>
</html>
